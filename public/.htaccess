# =========================
# SPA routing (Angular)
# =========================
RewriteEngine On

# Si el archivo o directorio no existe, sirve index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# =========================
# MIME básicos
# =========================
<IfModule mod_mime.c>
  AddType application/javascript js mjs
  AddType text/css css
  AddType application/json json
  AddType image/svg+xml svg
  AddType font/woff2 woff2
  AddType font/woff woff
</IfModule>

# =========================
# Compresión (Brotli / Gzip)
# =========================
<IfModule mod_brotli.c>
  BrotliCompressionQuality 5
  AddOutputFilterByType BROTLI_COMPRESS text/plain text/html text/xml text/css text/javascript \
    application/javascript application/x-javascript application/xml application/json image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css text/javascript \
    application/javascript application/x-javascript application/xml application/json image/svg+xml
  # Evitar problemas con proxies
  <IfModule mod_headers.c>
    Header append Vary Accept-Encoding
  </IfModule>
</IfModule>

# No comprimir binarios ya comprimidos
<IfModule mod_setenvif.c>
  SetEnvIfNoCase Request_URI "\.(?:gif|jpe?g|png|webp|avif|mp4|m4v|mov|zip|gz|bz2|7z|rar|woff2)$" no-gzip dont-vary
</IfModule>

# =========================
# Cache
# =========================
<IfModule mod_headers.c>
  # index.html SIN caché (para coger el último build)
  <Files "index.html">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </Files>

  # Assets versionados (Angular pone hash de contenido): 1 año + immutable
  # Coincide con ficheros tipo main.abcdef12.js, styles.12345678.css, etc.
  <FilesMatch "\.(?:js|mjs|css|json|svg|woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Respaldo por Expires (si algún proxy ignora Cache-Control)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css               "access plus 1 year"
  ExpiresByType application/json       "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 1 year"
  ExpiresByType font/woff2             "access plus 1 year"
  ExpiresByType font/woff              "access plus 1 year"
  ExpiresByType text/html              "access plus 0 seconds"
</IfModule>

# CORS para fuentes (si sirves desde subdominios)
<IfModule mod_headers.c>
  <FilesMatch "\.(?:woff2?|ttf|otf)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>
